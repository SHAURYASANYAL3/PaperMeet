{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/build/web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.ts"
    },
    {
      "src": "/(.+\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|json|woff|woff2|ttf|eot|html|wasm|map))$",
      "dest": "/frontend/build/web/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/build/web/assets/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/frontend/build/web/icons/$1"
    },
    {
      "src": "/canvaskit/(.*)",
      "dest": "/frontend/build/web/canvaskit/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/build/web/index.html"
    }
  ]
}
